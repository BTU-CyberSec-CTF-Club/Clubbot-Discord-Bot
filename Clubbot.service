# To be installed in .config/systemd/user
# Run systemctl --user daemon-reload, then systemctl --user enable Clubbot.service, then systemctl --user start Clubbot.service
# And run loginctl enable-linger $USER to ensure the service runs even when not logged-in
[Unit]
Description=Clubbot Discord Bot of the BTU CTF Club
After=network-online.target

StartLimitIntervalSec=1800
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/mildnfab/clubbot
ExecStart=%h/clubbot/start.sh
Restart=on-failure
RestartSec=150
StandardOutput=append:%h/clubbot/log_file
StandardError=append:%h/clubbot/log_file

[Install]
WantedBy=default.target
